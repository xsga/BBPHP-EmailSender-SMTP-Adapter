{
  "name": "xsga/bbphp-emailsender-smtp-adapter",
  "description": "A PHP library that provides an SMTP adapter for the BBPHP EmailSender Core library, enabling email sending functionality via SMTP protocol.",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/xsga/BBPHP-EmailSender-Core",
  "keywords": [
    "php",
    "email",
    "smtp",
    "adapter",
    "library",
    "bbphp",
    "emailsender"
  ],
  "authors": [
    {
      "name": "Parker",
      "email": "parker@xsga.es"
    }
  ],
  "require": {
    "php": "^8.4",
    "psr/log": "^3.0",
    "phpmailer/phpmailer": "^7.0",
    "xsga/bbphp-emailsender-core": "^1.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0",
    "vimeo/psalm": "^6.14",
    "phpmd/phpmd" : "^2.15",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-parallel-lint/php-console-highlighter": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Xsga\\BBPHP\\EmailSender\\Adapter\\Smtp\\": "Src/Xsga/BBPHP-EmailSender-SMTP-Adapter/"
    }
  },
  "scripts": {
    "lint": "parallel-lint --exclude vendor .",
    "style": "phpcs -p --colors --standard=PSR12 Src",
    "style-fix": "phpcbf -p --standard=PSR12 Src",
    "analyze-errors": "psalm --output-format=console --show-info=false --no-cache",
    "analyze-info": "psalm --output-format=console --show-info=true --no-cache",
    "analyze-md": "phpmd Src ansi cleancode,codesize,controversial,design,naming,unusedcode",
    "phploc": "phploc Src"
  },
  "config": {
    "github-protocols": [
      "https"
    ],
    "allow-plugins": {
      "php-http/discovery": false,
      "tbachert/spi": true
    }
  }
}
